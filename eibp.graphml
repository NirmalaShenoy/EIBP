<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <graph edgedefault="undirected">
	  <node id="c1" />
	  <node id="c2" />
    <node id="d1" />
    <node id="d2" />
    <node id="d3" />
    <node id="a1" />
    <node id="a2" />
    <node id="a3" />
    <node id="ipnode-1" />
    <node id="ipnode-2" />
    <node id="ipnode-3" />
    <edge source="c1" target="c2" />
    <edge source="c1" target="d1" />
    <edge source="c1" target="d2" />
    <edge source="c1" target="d3" />
    <edge source="c2" target="d1" />
    <edge source="c2" target="d2" />
    <edge source="c2" target="d3" />
    <edge source="d1" target="a1" />
    <edge source="d1" target="a2" />
    <edge source="d2" target="a1" />
    <edge source="d2" target="a3" />
    <edge source="d3" target="a2" />
    <edge source="d3" target="a3" />
    <edge source="a1" target="ipnode-1" />
    <edge source="a2" target="ipnode-2" />
    <edge source="a3" target="ipnode-3" />
  </graph>
</graphml>
